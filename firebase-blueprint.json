{
  "entities": {
    "Client": {
      "title": "Barbershop Client",
      "description": "Represents a barbershop that has subscribed to the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Name of the barbershop" },
        "subdomain": { "type": "string", "description": "Chosen subdomain for the barbershop" },
        "plan": { "type": "string", "enum": ["Plan Básico", "Plan Profesional", "Plan Elite"] },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] },
        "ownerId": { "type": "string", "description": "UID of the user who owns this barbershop" }
      },
      "required": ["name", "plan", "email", "createdAt"]
    }
  },
  "firestore": {
    "clients": {
      "schema": "Client",
      "description": "Collection of all barbershop clients registered on the platform."
    }
  }
}
